# Shahin Sandbox only. Replace the host and credentials with values issued for your app.
SHAHIN_TOKEN_URL=https://sandbox-host:28453/v0.3/obh/oauth/token
SHAHIN_API_BASE_URL=https://sandbox-host:38453/v0.3/obh/api
SHAHIN_BANK=BSI
SHAHIN_CLIENT_ID=
SHAHIN_CLIENT_SECRET=
SHAHIN_NATIONAL_CODE=
# Required for card lookup. Must be a source account authorized for this app.
SHAHIN_AUTHORIZED_SOURCE_ACCOUNT=
# Use the Sandbox test signature from the Shahin guide. Production signing is not implemented.
SHAHIN_OBH_SIGNATURE=
